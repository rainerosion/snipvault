{
  "$schema": "https://schemas.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for SnipVault",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "allow-get-snippets",
    "allow-query-snippets",
    "allow-get-snippet",
    "allow-open-revision-history",
    "allow-take-revision-history-restore-request",
    "allow-complete-revision-history-restore",
    "allow-restore-snippet-revision",
    "allow-record-snippet-usage",
    "allow-take-quick-capture-completion",
    "allow-get-snippet-tags",
    "allow-create-snippet",
    "allow-update-snippet",
    "allow-delete-snippet",
    "allow-search-snippets",
    "allow-toggle-favorite",
    "allow-set-snippets-favorite",
    "allow-delete-snippets",
    "allow-export-snippets",
    "allow-export-snippets-to-file",
    "allow-open-project-repository",
    "allow-open-trusted-directory",
    "allow-import-snippets",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-auto-start",
    "allow-is-auto-start-enabled",
    "allow-sync-upload",
    "allow-sync-download",
    "allow-get-sync-versions",
    "allow-list-sync-notifications",
    "allow-mark-sync-notification-read",
    "allow-dismiss-sync-notification",
    "allow-mark-all-sync-notifications-read",
    "allow-get-snapshot-status",
    "allow-create-local-snapshot",
    "allow-restore-local-snapshot",
    "allow-update-snapshot-policy",
    "allow-get-system-theme",
    "allow-get-system-locale",
    "allow-frontend-ready",
    "allow-boot-mark",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
  ]
}
